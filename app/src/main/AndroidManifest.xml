<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the console (PS Remote Play, Xbox's web player), the TVs and the translations, all on the home network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- finding the PS5 (broadcast on the home network) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- keeps translating while the screen is off (PS5) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- a USB capture card, which the phone lists as an external camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- updates from the app's releases: Android's installer asks to confirm each one -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The Wi-Fi permissions and the Xbox player's landscape screen would otherwise make Google Play
         require Wi-Fi and a landscape screen, hiding the app from devices without them (Ethernet works
         too, and the player also shows in portrait) -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <!-- (the camera permission would otherwise hide the app from devices without a camera) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />
    <!-- (a capture card is also looked for as a USB device: phones without USB host still get the app) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- usesCleartextTraffic: the TV page and the TV apps are plain HTTP on the home network -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".xbox.XboxActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".ps.PsnLoginActivity"
            android:exported="false" />

        <!-- A capture card plugged in (a USB video device): Android offers to open the app for it, and
             choosing it lets the app use the card (the USB permission). It only brings the app up. -->
        <activity
            android:name=".card.UsbAttachActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_video_devices" />
        </activity>

        <service
            android:name=".run.TranslateService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a PS Remote Play stream of the user's own console and the home-network page for the user's TV alive while the screen is off, to translate game subtitles live" />
        </service>

        <!-- the installer's answer to an update -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
