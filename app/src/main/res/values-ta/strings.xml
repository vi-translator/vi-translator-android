    <string name="ps_standby">ஓய்வு நிலை</string>
    <string name="ps_login_pin">PS5 கணக்கின் கடவுக்குறியீட்டைக் கேட்கிறது</string>
    <string name="ps_login_pin_wrong">தவறான கடவுக்குறியீடு: மீண்டும் முயலவும்</string>
    <string name="xbox_hint">மொழிபெயர்க்கத் தொடங்கு, Microsoft-இன் ரிமோட் பிளே பிளேயரை இங்கே திறக்கும். அங்கே உங்கள் Microsoft கணக்கில் உள்நுழைந்து உங்கள் Xbox-உடன் இணைக்கவும்; டிவி வழக்கம்போல் கன்சோலைக் காட்டும். விளையாடும்போது திரையை இயக்கத்தில் வைத்திருக்கவும்.</string>
    <string name="xbox_capture_screen">வீடியோவைப் படிக்க முடியவில்லை: திரையைப் பிடி</string>
    <string name="xbox_setup_status">உள்நுழைந்து, உங்கள் Xbox-ஐத் தேர்ந்தெடுக்கவும். முடிந்ததும் பின்செல்லவும்.</string>
    <string name="xbox_status">%1$d ஃப்ரேம்கள் படிக்கப்பட்டன (%2$s)</string>

    <string name="step_tv">2. டிவியை இணை</string>
    <string name="tv_hint">டிவியில் VI Translator-ஐத் திறக்கவும் (Android TV, LG அல்லது Samsung): அது 6 இலக்கக் குறியீட்டைக் காட்டும்.</string>
    <string name="tv_none">இன்னும் எந்த டிவியும் இணைக்கப்படவில்லை.</string>
    <string name="tv_find">டிவிகளைக் கண்டுபிடி</string>
    <string name="tv_found_none">டிவி கிடைக்கவில்லை: டிவி செயலி திறந்து, அதே நெட்வொர்க்கில் உள்ளதா? அதன் முகவரியைத் தட்டச்சு செய்யலாம்.</string>
    <string name="tv_address">டிவி முகவரி</string>
    <string name="tv_code">டிவி காட்டும் குறியீடு</string>
    <string name="tv_connect">இணைக்கவும்</string>
    <string name="tv_connecting">இணைக்கிறது…</string>
    <string name="tv_connected">இணைக்கப்பட்டது.</string>
    <string name="tv_wrong_code">அது டிவி காட்டும் குறியீடு அல்ல.</string>
    <string name="tv_new_code">அதிகமான தவறான குறியீடுகள்: டிவி புதிய குறியீட்டைக் காட்டுகிறது.</string>
    <string name="tv_unreachable">டிவி பதிலளிக்கவில்லை: டிவி செயலி திறந்துள்ளதா?</string>
    <string name="tv_missing">ஒரு டிவியைத் தேர்ந்தெடுத்து (அல்லது அதன் முகவரியைத் தட்டச்சு செய்து) 6 இலக்கக் குறியீட்டை உள்ளிடவும்.</string>
    <string name="tv_forget">துண்டி</string>
    <string name="searching">தேடுகிறது…</string>

