    <string name="step_console">1. உங்கள் கன்சோல்</string>
    <string name="playstation">PlayStation 5</string>
    <string name="xbox">Xbox</string>
    <string name="ps_setup_hint">விளையாட்டைப் படிக்கப் போன் ரிமோட் பிளே மூலம் PS5-ஐ ஸ்ட்ரீம் செய்கிறது; டிவி வழக்கம்போல் கன்சோலைக் காட்டும். ஒருமுறை அமைக்கவும்: PS5-இல், அமைப்புகள் › சிஸ்டம் › ரிமோட் பிளே › சாதனத்தை இணை ஒரு PIN-ஐக் காட்டும்.</string>
    <string name="ps_find">PS5-ஐக் கண்டுபிடி</string>
    <string name="ps_address">PS5 முகவரி (192.168.1.20)</string>
    <string name="psn_secondary_hint">நீங்கள் விளையாடும் கணக்கு அல்லாமல், இரண்டாவது PSN கணக்கில் உள்நுழையவும்: ரிமோட் பிளே அதை PS5-இல் உள்நுழைக்கும். அதன் கணக்கு ID மட்டுமே வைக்கப்படும்.</string>
    <string name="psn_sign_in">PSN-இல் உள்நுழை</string>
    <string name="psn_failed">PSN உள்நுழைவு வேலை செய்யவில்லை: %1$s</string>
    <string name="psn_account_id">PSN கணக்கு ID</string>
    <string name="ps_pin">PS5 காட்டும் 8 இலக்க PIN</string>
    <string name="ps_register">இணை</string>
    <string name="ps_wake">PS5-ஐ எழுப்பு</string>
    <string name="ps_registering">இணைக்கிறது…</string>
